{
  "name": "boardgame",
  "version": "0.30.2",
  "private": true,
  "type": "module",
  "description": "朋友邀請制的線上桌遊平台",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.cjs",
    "check:public": "node scripts/check-public-repo.mjs",
    "test:public": "node --test scripts/check-public-repo.test.mjs"
  },
  "dependencies": {
    "boardgame.io": "0.50.2",
    "dotenv": "^16.6.1",
    "koa-static": "^5.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.25.0",
    "socket.io-client": "4.8.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@koa/cors": "^5.0.0",
    "socket.io": "^4.8.1",
    "cookie": "^0.7.2",
    "svelte": "^5.55.7"
  }
}
