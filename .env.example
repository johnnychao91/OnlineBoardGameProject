# 複製成 .env。此檔僅提供可公開的開發預設值，請勿在此填入真實密鑰。
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_ORIGIN=http://localhost:5173
DATA_DIR=./data

# PUBLIC_ORIGIN 不能含路徑、查詢字串或尾斜線；production 必須使用 HTTPS。
# HOST 預設僅監聽本機；若修改 PORT，開發時需同步調整 vite.config.ts 的代理。

# 開房不需要密碼；未填房間暗語時建立一般廣告房。
# 選填免廣告暗語，至少 16 字元；留空停用。免廣告房仍計正常成績。
# 暗語只在建立房間時使用，不是入房邀請或座位憑證。
ROOM_CODE=
# 選填測試房暗語，至少 16 字元且須與 ROOM_CODE 不同；留空停用。
# 測試房不載入廣告、不計成績，房主可新增虛擬玩家。
# 真實暗語只能放在 Git 外的私有設定，不能填入這份範本。
TEST_ROOM_CODE=
# AdSense 手動版位；未完整設定時不載入廣告。實際帳戶碼及廣告碼留在私有設定。
ADSENSE_CLIENT=
ADSENSE_SLOT=
# 公開隱私權聯絡方式：電子郵件或 HTTPS 聯絡頁。
PRIVACY_CONTACT=

# 正式環境範例（請在私有 .env 或 /etc/boardgame.env 中設定）：
# example.com 是示範值；真實站點只能寫入私有設定，不要改此公開檔案。
# NODE_ENV=production
# PUBLIC_ORIGIN=https://boardgame.example.com
# DATA_DIR=/var/lib/boardgame
